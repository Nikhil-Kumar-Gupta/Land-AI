# Copy to backend_py/.env and adjust.
# PostgreSQL + PostGIS (target). If DATABASE_URL is omitted a local SQLite file is used for development.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/sanket_ai

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=480

# true = OTP is returned by the API and shown on screen (demo). Set false in production and configure SMTP.
OTP_DEV_MODE=true
OTP_EXPIRE_MINUTES=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
